<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/regex_builder_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.fossify.commons.views.MyAppBarLayout
        android:id="@+id/regex_builder_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/regex_builder_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/color_primary"
            app:menu="@menu/menu_regex_builder"
            app:title="@string/build_regex"
            app:titleTextAppearance="@style/AppTheme.ActionBar.TitleTextStyle" />

    </org.fossify.commons.views.MyAppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/regex_builder_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/regex_builder_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/activity_margin">

            <TextView
                android:id="@+id/regex_try_label"
                style="@style/SettingsSectionLabelStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/regex_try" />

            <org.fossify.commons.views.MyTextInputLayout
                android:id="@+id/regex_sample_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/activity_margin"
                android:layout_marginEnd="@dimen/activity_margin"
                android:hint="@string/regex_sample_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/regex_sample_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine|textNoSuggestions" />

            </org.fossify.commons.views.MyTextInputLayout>

            <org.fossify.commons.views.MyTextView
                android:id="@+id/regex_try_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/activity_margin"
                android:layout_marginTop="@dimen/small_margin"
                android:layout_marginEnd="@dimen/activity_margin"
                android:textSize="@dimen/normal_text_size"
                android:visibility="gone" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/regex_builder_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.8"
                android:paddingStart="@dimen/activity_margin"
                android:paddingTop="@dimen/activity_margin"
                android:paddingEnd="@dimen/activity_margin"
                android:paddingBottom="@dimen/medium_margin"
                android:text="@string/regex_builder_hint"
                android:textSize="@dimen/smaller_text_size" />

            <TextView
                android:id="@+id/regex_match_label"
                style="@style/SettingsSectionLabelStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/regex_match" />

            <RadioGroup
                android:id="@+id/regex_match_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/activity_margin"
                android:layout_marginEnd="@dimen/activity_margin">

                <org.fossify.commons.views.MyCompatRadioButton
                    android:id="@+id/regex_match_anywhere"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/regex_match_anywhere" />

                <org.fossify.commons.views.MyCompatRadioButton
                    android:id="@+id/regex_match_start"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/regex_match_start" />

                <org.fossify.commons.views.MyCompatRadioButton
                    android:id="@+id/regex_match_end"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/regex_match_end" />

                <org.fossify.commons.views.MyCompatRadioButton
                    android:id="@+id/regex_match_whole"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/regex_match_whole" />

            </RadioGroup>

            <TextView
                android:id="@+id/regex_pieces_label"
                style="@style/SettingsSectionLabelStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/regex_pieces" />

            <LinearLayout
                android:id="@+id/regex_pieces"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/activity_margin"
                android:layout_marginEnd="@dimen/activity_margin"
                android:orientation="vertical" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/regex_add_piece"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/medium_margin"
                android:layout_marginTop="@dimen/small_margin"
                android:layout_marginEnd="@dimen/medium_margin"
                android:background="@drawable/ripple_all_corners"
                android:padding="@dimen/medium_margin"
                android:text="@string/regex_add_piece"
                android:textSize="@dimen/normal_text_size" />

            <TextView
                android:id="@+id/regex_pattern_label"
                style="@style/SettingsSectionLabelStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/regex_pattern" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/regex_pattern_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/activity_margin"
                android:layout_marginEnd="@dimen/activity_margin"
                android:textIsSelectable="true"
                android:typeface="monospace"
                android:textSize="@dimen/normal_text_size" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
