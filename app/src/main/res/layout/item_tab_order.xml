<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tab_order_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:longClickable="true"
    android:minHeight="@dimen/normal_icon_size"
    android:paddingStart="@dimen/activity_margin"
    android:paddingTop="@dimen/medium_margin"
    android:paddingEnd="@dimen/small_margin"
    android:paddingBottom="@dimen/medium_margin">

    <LinearLayout
        android:id="@+id/tab_order_texts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toStartOf="@+id/tab_order_drag_handle"
        android:orientation="vertical">

        <org.fossify.commons.views.MyTextView
            android:id="@+id/tab_order_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/bigger_text_size"
            tools:text="@string/messages" />

        <org.fossify.commons.views.MyTextView
            android:id="@+id/tab_order_hidden"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tab_hidden"
            android:textSize="@dimen/smaller_text_size"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>

    <ImageView
        android:id="@+id/tab_order_drag_handle"
        android:layout_width="@dimen/normal_icon_size"
        android:layout_height="@dimen/normal_icon_size"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/reorder_tab"
        android:padding="@dimen/small_margin"
        android:src="@drawable/ic_drag_handle_vector" />

</RelativeLayout>
