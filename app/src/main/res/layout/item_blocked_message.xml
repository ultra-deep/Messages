<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/blocked_message_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/tiny_margin"
    android:clickable="true"
    android:focusable="true"
    android:paddingTop="@dimen/medium_margin"
    android:paddingBottom="@dimen/medium_margin">

    <org.fossify.commons.views.MyTextView
        android:id="@+id/blocked_message_sender"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_marginStart="@dimen/activity_margin"
        android:layout_marginEnd="@dimen/medium_margin"
        android:layout_toStartOf="@+id/blocked_message_date"
        android:ellipsize="end"
        android:maxLines="1"
        android:textSize="@dimen/list_primary_text_size"
        tools:text="Jane" />

    <org.fossify.commons.views.MyTextView
        android:id="@+id/blocked_message_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/blocked_message_sender"
        android:layout_marginEnd="@dimen/small_margin"
        android:layout_toStartOf="@+id/overflow_menu_icon"
        android:maxLines="1"
        android:textSize="@dimen/list_secondary_text_size"
        tools:text="12:30" />

    <org.fossify.commons.views.MyTextView
        android:id="@+id/blocked_message_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/blocked_message_sender"
        android:layout_alignParentStart="true"
        android:layout_marginStart="@dimen/activity_margin"
        android:layout_marginTop="@dimen/tiny_margin"
        android:layout_marginEnd="@dimen/medium_margin"
        android:layout_toStartOf="@+id/overflow_menu_icon"
        android:ellipsize="end"
        android:maxLines="4"
        android:textSize="@dimen/list_secondary_text_size"
        tools:text="Blocked message text" />

    <ImageView
        android:id="@+id/overflow_menu_icon"
        style="@style/OverflowMenuIconStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true" />

    <View
        android:id="@+id/overflow_menu_anchor"
        style="@style/OverflowMenuAnchorStyle"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true" />

</RelativeLayout>
